model Users {
  id         String   @id @default(uuid()) @db.Uuid
  role_id    String   @db.Uuid

  username   String   @unique @db.VarChar
  password   String   @db.VarChar

  is_active  Boolean  @default(true)
  last_login DateTime? @db.Timestamp

  created_at DateTime  @default(now()) @db.Timestamp
  updated_at DateTime  @updatedAt @db.Timestamp
  deleted_at DateTime? @db.Timestamp

  roles Roles @relation(fields: [role_id], references: [id])
  profile Profile?
  teachingJournalsCreated TeachingJournals[] @relation("TeachingJournalCreatedBy")
  teachingJournalsUpdated TeachingJournals[] @relation("TeachingJournalUpdatedBy")
  modulesCreated Modules[] @relation("ModuleCreator")
  modulesUpdated Modules[] @relation("ModuleUpdater")
  examinationsCreated Examinations[] @relation("ExaminationCreatedBy")
  examinationsUpdated Examinations[] @relation("ExaminationUpdatedBy")
  examinationScores ExaminationScores[]
  assignmentSubmissions AssignmentSubmission[]

  @@index([role_id])
}