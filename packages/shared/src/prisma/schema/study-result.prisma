model StudyResult {
  id               String   @id @default(uuid()) @db.Uuid
  studentId        String   @db.Uuid @map("student_id")
  academicYearId   String   @db.Uuid @map("academic_year_id")
  semesterId       String   @db.Uuid @map("semester_id")
  totalCredits     Int?     @map("total_credits")
  semesterGpa      Decimal? @db.Decimal(4, 2) @map("semester_gpa")
  cumulativeGpa    Decimal? @db.Decimal(4, 2) @map("cumulative_gpa")
  academicStatusId String?  @db.Uuid @map("academic_status_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student        Student        @relation(fields: [studentId], references: [id])
  academicYear   AcademicYears   @relation(fields: [academicYearId], references: [id])
  
  academicStatus AcademicStatuses? @relation(fields: [academicStatusId], references: [id])

  @@unique([studentId, academicYearId, semesterId])
  @@map("study_results")
}