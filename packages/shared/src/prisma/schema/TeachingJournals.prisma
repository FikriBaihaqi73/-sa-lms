model TeachingJournals {
  // base
  id         String    @id @default(uuid()) @db.Uuid
  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamp
  updated_at DateTime  @updatedAt @db.Timestamp
  createdBy  Users?    @relation("TeachingJournalCreatedBy", fields: [created_by], references: [id])
  updatedBy  Users?    @relation("TeachingJournalUpdatedBy", fields: [updated_by], references: [id])
  deleted_at DateTime? @db.Timestamp

  // attributes
  schedule_id    String    @db.Uuid
  meeting_number Int?
  journal_date   DateTime? @db.Date
  topic          String?   @db.VarChar
  material       String?   @db.Text
  notes          String?   @db.Text

  // relations
  schedule Schedule @relation(fields: [schedule_id], references: [id])

  @@index([schedule_id])
  @@index([created_by])
  @@index([updated_by])
}
