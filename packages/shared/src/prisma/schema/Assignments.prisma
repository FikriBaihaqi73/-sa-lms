model Assignments {
  // base
  id         String    @id @default(uuid()) @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamp
  updated_at DateTime  @updatedAt @db.Timestamp
  deleted_at DateTime? @db.Timestamp

  // attributes
  module_id          String    @db.Uuid
  assignment_type_id String    @db.Uuid
  title              String    @db.VarChar
  description        String?   @db.Text
  due_date           DateTime? @db.Timestamp
  max_score          Decimal?

  // relations
  module                Modules                @relation(fields: [module_id], references: [id])
  assignment_type       AssignmentTypes        @relation(fields: [assignment_type_id], references: [id])
  assignmentSubmissions AssignmentSubmission[]

  @@index([module_id])
  @@index([assignment_type_id])
}
