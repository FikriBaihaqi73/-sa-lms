model Examinations {
  id String @id @default(uuid()) @db.Uuid

  classSubjectId String? @map("class_subject_id") @db.Uuid
  assignmentTypeId String? @map("assignment_type_id") @db.Uuid

  title String @db.VarChar(255)
  description String? @db.Text
  examinationDate DateTime? @map("examination_date") @db.Timestamp
  duration Int?
  maximumScore Decimal? @map("maximum_score") @db.Decimal(5, 2)

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp
  deletedAt DateTime? @map("deleted_at") @db.Timestamp

  classSubject ClassSubjects? @relation(fields: [classSubjectId], references: [id])
  assignmentType AssignmentTypes? @relation(fields: [assignmentTypeId], references: [id])
  creator Users? @relation("ExaminationCreatedBy", fields: [createdBy], references: [id])
  updater Users? @relation("ExaminationUpdatedBy", fields: [updatedBy], references: [id])
  scores ExaminationScores[]

  @@index([classSubjectId])
  @@index([assignmentTypeId])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("examinations")
}
