model Examinations {
  id                 String    @id @default(uuid()) @db.Uuid
  class_subject_id   String    @db.Uuid
  assignment_type_id String    @db.Uuid

  title              String    @db.VarChar
  description        String?   @db.Text
  examination_date   DateTime? @db.Timestamp
  duration           Int?
  maximum_score      Decimal?  @db.Decimal(5, 2)

  created_by         String?   @db.Uuid
  updated_by         String?   @db.Uuid

  created_at         DateTime  @default(now()) @db.Timestamp
  updated_at         DateTime  @updatedAt @db.Timestamp
  deleted_at         DateTime? @db.Timestamp

  class_subject      ClassSubjects   @relation(fields: [class_subject_id], references: [id])
  assignment_type    AssignmentTypes @relation(fields: [assignment_type_id], references: [id])
  creator            Users?          @relation("ExaminationCreatedBy", fields: [created_by], references: [id])
  updater            Users?          @relation("ExaminationUpdatedBy", fields: [updated_by], references: [id])

  @@index([class_subject_id])
  @@index([assignment_type_id])
  @@index([created_by])
  @@index([updated_by])
  @@map("examinations")
}