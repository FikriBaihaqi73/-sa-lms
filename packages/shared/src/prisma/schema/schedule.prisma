model Schedule {
  // base
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") @db.Timestamp

  // attributes
  classSubjectId String    @map("class_subject_id") @db.Uuid
  classroomId    String    @map("classroom_id") @db.Uuid
  day            String
  startTime      DateTime? @map("start_time") @db.Time(0)
  endTime        DateTime? @map("end_time") @db.Time(0)

  // relations
  attendances       Attendances[] 
  teaching_journals TeachingJournals[]

  @@map("schedules")
}
